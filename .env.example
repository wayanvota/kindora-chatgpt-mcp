# Transport: "stdio" (local) or "http" (required for ChatGPT)
TRANSPORT=http

# HTTP transport settings (used when TRANSPORT=http)
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp

# Upstream Kindora MCP endpoint to proxy. Override if Kindora changes it,
# or copy the exact URL from your Claude connector directory entry.
KINDORA_MCP_URL=https://mcp.kindora.co/mcp

# Optional. Leave blank for the public/free tier. Set if you have a Kindora key;
# it is forwarded to Kindora as "Authorization: Bearer <key>".
KINDORA_API_KEY=

# Seconds to wait on an upstream call before failing.
KINDORA_TIMEOUT=60
